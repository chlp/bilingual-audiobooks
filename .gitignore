# Личные книги: аудио, тексты, картинки, сборки. Наружу не уходят.
/books/*
!/books/README.md

# Примеры: в git только исходники (book.json, text/, illustrations/),
# собранное публикуется в docs/ через tools/publish.py
/examples/*/audio.mp3
/examples/*/index.html
/examples/*/build/
/examples/*/pdf/
/examples/*/illustrations/web/

# Голоса Piper (большие, скачиваются tools/get_voice.sh)
/voices/

# Личный сайт: tools/publish.py books/<slug> -> web/<slug>/ + web/index.html
/web/

# Окружения
.venv-*/
__pycache__/
*.pyc
.DS_Store

# Варианты референсов примеров: в git только выбранные refs/<id>.png и контакт-лист _variants.png
/examples/*/illustrations/refs/*-v[0-9]*.png
